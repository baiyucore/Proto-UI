---
import { AdapterIds } from './runtimes/registry';
import { PREFERRED_KEY, DEFAULT_ADAPTER } from '../override/AdapterSelect.astro';
---

<script is:inline define:vars={{ PREFERRED_KEY, DEFAULT_ADAPTER, AdapterIds }}>
  (function () {
    if (window.__protoAdapterPanelInit === '1') return;
    window.__protoAdapterPanelInit = '1';

    function pageAdapters() {
      var found = {};
      document.querySelectorAll('[data-adapter-panel]').forEach(function (el) {
        found[el.getAttribute('data-adapter-panel')] = true;
      });
      return found;
    }

    function resolveAdapter(adapter) {
      var available = pageAdapters();
      if (!Object.keys(available).length) return adapter;
      if (available[adapter]) return adapter;
      if (available[DEFAULT_ADAPTER]) return DEFAULT_ADAPTER;
      return Object.keys(available)[0];
    }

    function showPanel(adapter) {
      var panels = document.querySelectorAll('[data-adapter-panel]');
      if (!panels.length) return;
      var effective = resolveAdapter(adapter);
      panels.forEach(function (el) {
        el.style.display = el.getAttribute('data-adapter-panel') === effective ? '' : 'none';
      });
    }

    function getPreferred() {
      try {
        let SelectedAdapter = localStorage.getItem(PREFERRED_KEY);
        return SelectedAdapter && AdapterIds.indexOf(SelectedAdapter) !== -1
          ? SelectedAdapter
          : DEFAULT_ADAPTER;
      } catch (e) {
        return DEFAULT_ADAPTER;
      }
    }

    function syncPreferredPanel() {
      showPanel(getPreferred());
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncPreferredPanel, { once: true });
    } else {
      syncPreferredPanel();
    }

    document.addEventListener('proto-adapter:change', function (e) {
      // CodePanel / previewer-client 也会派发同名事件做布局同步，不一定带 adapter。
      var adapter = e && e.detail && e.detail.adapter;
      if (!adapter) return;
      showPanel(adapter);
    });
  })();
</script>
